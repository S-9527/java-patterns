<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.s9527</groupId>
    <artifactId>java-patterns</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>runner</artifactId>
  <name>runner</name>
  <description>
    全项目唯一存在跨模块依赖的地方：依赖全部 14 个场景模块，
    shade 成单个可执行 jar，按固定教学顺序调用各 Demo.run()。
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>money-decorator</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>order-builder</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>order-state</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>risk-chain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>pipeline</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>domain-events</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>payment-gateway</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>checkout-facade</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>order-command</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>catalog-flyweight</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>singleton-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>dynamic-proxy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>visitor-vs-switch</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.s9527</groupId>
      <artifactId>scoped-values</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>java-patterns</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>demo.runner.RunAll</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>